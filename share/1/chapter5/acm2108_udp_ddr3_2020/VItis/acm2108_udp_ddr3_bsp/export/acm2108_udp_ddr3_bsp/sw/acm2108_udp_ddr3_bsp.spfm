<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="acm2108_udp_ddr3_bsp"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
acm2108_udp_ddr3_bsp
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="acm2108_udp_ddr3_bsp">
        <sdx:configuration sdx:name="acm2108_udp_ddr3_bsp"
                           sdx:displayName="acm2108_udp_ddr3_bsp"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>acm2108_udp_ddr3_bsp</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="acm2108_udp_ddr3_bsp/boot/acm2108_udp_ddr3_bsp.bif"
                            sdx:readme="acm2108_udp_ddr3_bsp/boot/generic.readme"
                            sdx:qemuArguments="acm2108_udp_ddr3_bsp/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="acm2108_udp_ddr3_bsp/boot/acm2108_udp_ddr3_bsp.bif"
                            sdx:readme="acm2108_udp_ddr3_bsp/boot/generic.readme"
                            sdx:qemuArguments="acm2108_udp_ddr3_bsp/standalone_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on ps7_cortexa9_0"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="acm2108_udp_ddr3_bsp/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="acm2108_udp_ddr3_bsp/standalone_domain/bspinclude/include"
                        sdx:bspConfig="acm2108_udp_ddr3_bsp/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
