####### Compile

main.o: main.cpp mainwindow.h \
		tracker_bridge.h \
		../chapter5/ps_tracker/tracker_app.h \
		../chapter5/ps_tracker/tracker3d.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

mainwindow.o: mainwindow.cpp mainwindow.h \
		tracker_bridge.h \
		../chapter5/ps_tracker/tracker_app.h \
		../chapter5/ps_tracker/tracker3d.h \
		ui_mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o mainwindow.cpp

tracker_app.o: ../chapter5/ps_tracker/tracker_app.c ../chapter5/ps_tracker/tracker_app.h \
		../chapter5/ps_tracker/tracker3d.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o tracker_app.o ../chapter5/ps_tracker/tracker_app.c

tracker3d.o: ../chapter5/ps_tracker/tracker3d.c ../chapter5/ps_tracker/tracker3d.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o tracker3d.o ../chapter5/ps_tracker/tracker3d.c

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/test1/bin || mkdir -p $(INSTALL_ROOT)/opt/test1/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/test1/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/test1/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/test1/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

